{
  "name": "spotlight-lingo",
  "version": "1.2.8",
  "description": "Spotlight Lingo. Translate Subtitles: Youtube, Netflix, Amazon Prime",
  "scripts": {
    "start": "node_modules/parcel/lib/bin.js watch manifest.json --config @parcel/config-webextension --no-hmr",
    "build": "node_modules/parcel/lib/bin.js build manifest.json --config @parcel/config-webextension",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs",
    "build-server": "vercel build && cpy ./static .vercel/output --no-overwrite",
    "pack": "bestzip build/v$npm_package_version.zip dist/*",
    "pack:firefox": "cd dist-firefox && ../node_modules/.bin/bestzip ../build/v$npm_package_version-firefox.xpi *",
    "sign:firefox": "web-ext sign --source-dir=dist-firefox --artifacts-dir=build --channel=unlisted",
    "pack:sources": "bestzip build/v$npm_package_version-sources.zip src manifest.json package.json package-lock.json scripts types tsconfig.json readme.md",
    "analize": "parcel build manifest.json --config @parcel/config-webextension --reporter @parcel/reporter-bundle-analyzer"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/chrome": "0.0.268",
    "@types/lodash-es": "^4.17.12",
    "@vercel/functions": "^1.4.1",
    "@vercel/postgres": "^0.10.0",
    "countries-and-timezones": "^3.6.0",
    "cpy-cli": "^5.0.0",
    "lodash-es": "^4.17.21",
    "ua-parser-js": "^1.0.39",
    "wink-porter2-stemmer": "^2.0.1"
  },
  "devDependencies": {
    "@parcel/config-webextension": "^2.12.0",
    "@parcel/reporter-bundle-analyzer": "^2.12.0",
    "@parcel/transformer-inline-string": "^2.12.0",
    "@types/node": "^22.4.1",
    "@types/ua-parser-js": "^0.7.39",
    "bestzip": "^2.2.1",
    "parcel": "^2.12.0",
    "prettier": "3.3.3",
    "typescript": "^5.5.3",
    "web-ext": "^10.1.0"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version"
  ]
}
